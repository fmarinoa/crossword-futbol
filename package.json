{
  "name": "crossword-futbol",
  "private": true,
  "version": "0.0.4",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24"
  },
  "author": {
    "name": "Franco Mariño",
    "url": "https://github.com/fmarinoa/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmarinoa/crossword-futbol.git",
    "directory": "crossword-futbol"
  },
  "scripts": {
    "dev": "vite --host",
    "worker:dev": "wrangler dev",
    "build": "tsc -b && vite build",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint .",
    "preview": "vite preview",
    "words:ai": "node --experimental-strip-types scripts/generate-words.ts",
    "migration:remote": "export CI=true; wrangler d1 migrations apply crossword-futbol-words --remote",
    "commit": "sh -c 'git commit -m \"$(agy -p \"Generate a concise conventional commit message based on this diff, response only in text format, without any extra text or markdown: $(git diff --staged)\")\"'",
    "commit:all": "git add . && npm run commit",
    "pr:create": "gh pr create -t \"$(git branch --show-current)\" -b \"\""
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/workers-types": "5.20260728.1",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.1",
    "wrangler": "4.114.0"
  }
}
